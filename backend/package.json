{
  "name": "@paycash/backend",
  "version": "1.0.0",
  "description": "PayCash Cameroon - Backend Microservices Platform",
  "author": "PayCash Team",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "npm run build:gateway && npm run build:transaction && npm run build:partner && npm run build:fee && npm run build:notification",
    "build:gateway": "nest build --path api-gateway/tsconfig.json",
    "build:transaction": "nest build --path transaction-service/tsconfig.json",
    "build:partner": "nest build --path partner-service/tsconfig.json",
    "build:fee": "nest build --path fee-service/tsconfig.json",
    "build:notification": "nest build --path notification-service/tsconfig.json",
    "format": "prettier --write \"{api-gateway,transaction-service,partner-service,fee-service,notification-service,shared-types}/src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "concurrently -n gateway,transaction,partner,fee,notification -c cyan,green,yellow,blue,magenta \"npm run start:dev:gateway\" \"npm run start:dev:transaction\" \"npm run start:dev:partner\" \"npm run start:dev:fee\" \"npm run start:dev:notification\"",
    "start:gateway": "nest start --path api-gateway/tsconfig.json",
    "start:dev:gateway": "nest start --watch --path api-gateway/tsconfig.json",
    "start:dev:transaction": "nest start --watch --path transaction-service/tsconfig.json",
    "start:dev:partner": "nest start --watch --path partner-service/tsconfig.json",
    "start:dev:fee": "nest start --watch --path fee-service/tsconfig.json",
    "start:dev:notification": "nest start --watch --path notification-service/tsconfig.json",
    "lint": "eslint \"{api-gateway,transaction-service,partner-service,fee-service,notification-service,shared-types}/src/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.0.0",
    "concurrently": "^10.0.4",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "roots": [
      "<rootDir>/shared-types/src",
      "<rootDir>/api-gateway/src",
      "<rootDir>/transaction-service/src",
      "<rootDir>/partner-service/src",
      "<rootDir>/fee-service/src",
      "<rootDir>/notification-service/src"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "{api-gateway,transaction-service,partner-service,fee-service,notification-service,shared-types}/src/**/*.(t|j)s",
      "!**/*.spec.ts"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  }
}
